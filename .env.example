# PostgreSQL
# Lokal (via kubectl port-forward -n coalita svc/coalita-db-rw 5432:5432):
DATABASE_URL=postgresql://coalita:password@localhost:5432/coalita
# Im Cluster (Kubernetes):
# DATABASE_URL=postgresql://coalita:password@coalita-db-rw.coalita.svc.cluster.local:5432/coalita

# Zitadel (Identity Management)
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=your_client_id
ZITADEL_CLIENT_SECRET=your_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
